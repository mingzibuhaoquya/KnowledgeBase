COMPOSE_PROJECT_NAME=knowledgebase

# Ports intentionally avoid APITestPlatform defaults shown in Docker Desktop.
KB_MYSQL_PORT=3318
KB_QDRANT_HTTP_PORT=6338
KB_QDRANT_GRPC_PORT=6339
KB_REDIS_PORT=6388
KB_BACKEND_PORT=8018
KB_FRONTEND_PORT=5188

MYSQL_ROOT_PASSWORD=knowledgebase_root
MYSQL_DATABASE=knowledge_base
MYSQL_USER=knowledgebase
MYSQL_PASSWORD=knowledgebase_pass
SECRET_KEY=change-me-before-production
VITE_API_BASE_URL=http://127.0.0.1:8018/api/v1

